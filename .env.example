# Sao chép thành .env rồi điền giá trị từ Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- CHỈ đặt trên Vercel (Settings -> Environment Variables), KHÔNG có tiền tố VITE_ ---
# Đọc số ODO từ ảnh (api/ocr-odo.js). Thiếu biến này: app dùng Tesseract trong trình duyệt.
# ANTHROPIC_API_KEY=
# Tạo tài khoản từ tab Quản trị (api/admin-create-user.js)
# SUPABASE_SERVICE_ROLE_KEY=
